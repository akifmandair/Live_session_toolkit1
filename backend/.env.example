# Copy this file to .env and adjust as needed.

# PostgreSQL (recommended). Example for local docker-compose setup:
DATABASE_URL=postgresql://lst_user:lst_password@localhost:5432/live_session_toolkit

# If you don't want to run Postgres locally, comment the line above and
# uncomment the line below to use a local SQLite file instead - handy for
# a quick first run, but switch to Postgres before you rely on this for real.
# DATABASE_URL=sqlite:///./dev.db

# Used to sign JWT access tokens. Generate your own random string for real use,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Optional — powers AI question generation, open-ended grading, and response
# summaries. Leave blank to run without those features; the endpoints return
# a clear error instead of crashing the app.
#
# Get a free key at https://aistudio.google.com/apikey — use your own personal
# free-tier key here. Never a work/company key or paid API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
